<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Waylo brand palette v2: deep navy + warm coral/amber accent.
         No pure black or pure white anywhere. Contrast verified (WCAG AA,
         large text, >=3:1): coral-on-navy ~4.3:1, white-on-coral ~3.7:1. -->
    <color name="navy">#0D1B2A</color>
    <color name="navy_card">#16283D</color>
    <color name="navy_elevated">#1E3350</color>
    <color name="coral">#D9531F</color>
    <color name="coral_dark">#B8420F</color>

    <!-- Soft off-white — intentionally not pure #FFFFFF. -->
    <color name="white">#FFF5F5F0</color>

    <!-- Translucent off-whites for secondary text -->
    <color name="white_70">#B3F5F5F0</color>
    <color name="white_60">#99F5F5F0</color>
    <color name="white_50">#80F5F5F0</color>
    <color name="white_12">#1FF5F5F0</color>

    <!-- Status badge dots: functional traffic-light semantics, independent of the accent. -->
    <color name="status_green">#3DDC84</color>
    <color name="status_red">#FF4D4D</color>
    <color name="status_gray">#5A6B82</color>

    <!-- Legacy keys kept so older references still resolve -->
    <color name="saffron">#D9531F</color>
    <color name="saffron_dark">#B8420F</color>
</resources>
